{
  "name": "crosstalk-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "pg": "8.16.3",
    "server-only": "0.0.1",
    "lucide-react": "1.59.0",
    "@radix-ui/react-dialog": "1.3.1",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/pg": "8.15.5",
    "vitest": "4.1.11",
    "@playwright/test": "1.64.1"
  }
}
