# Copy to dashboard/.env.local. Run the worker/migrations first.
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crosstalk
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
# Generate each independently: openssl rand -hex 32
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
WORKER_CONTROL_URL=http://localhost:3100
# Same value as worker; generate with openssl rand -hex 32
WORKER_CONTROL_SECRET=
