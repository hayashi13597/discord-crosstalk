# Original three distinct bot applications; keep these worker keys stable.
BOT_TOKEN_1=
BOT_TOKEN_2=
BOT_TOKEN_3=
# Optional extra workers for Group B. Add their channels using /team add.
BOT_TOKEN_4=
BOT_TOKEN_5=
BOT_TOKEN_6=
GUILD_ID=
# Legacy Group A bootstrap only; persisted teams take precedence after first startup.
VOICE_CHANNEL_ID_1=
VOICE_CHANNEL_ID_2=
VOICE_CHANNEL_ID_3=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crosstalk
# Optional comma-separated role IDs, in addition to Manage Guild.
ADMIN_ROLE_IDS=
JITTER_BUFFER_MS=60
MAX_QUEUE_MS=200
SINGLE_SOURCE_GAIN=1
MIX_SOURCE_GAIN=0.5
LOG_LEVEL=info
