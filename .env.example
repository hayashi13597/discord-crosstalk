# Original three distinct bot applications; keep these worker keys stable.
BOT_TOKEN_1=
BOT_TOKEN_2=
BOT_TOKEN_3=
# Optional extra workers. Add their channels using /team add.
BOT_TOKEN_4=
BOT_TOKEN_5=
BOT_TOKEN_6=
GUILD_ID=
# Discord role shared by all relay leaders (role ID, not its name).
LEADER_ROLE_ID=
# Voice channels are configured with /team add, not environment variables.
DATABASE_PATH=./data/crosstalk.sqlite
# Optional comma-separated role IDs, in addition to Manage Guild.
ADMIN_ROLE_IDS=
JITTER_BUFFER_MS=60
MAX_QUEUE_MS=200
SINGLE_SOURCE_GAIN=1
MIX_SOURCE_GAIN=0.5
LOG_LEVEL=info
